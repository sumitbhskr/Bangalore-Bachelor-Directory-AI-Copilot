# Backend/.env.example
# Copy to Backend/.env and fill in real values. NEVER commit Backend/.env.

# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Frontend origin (CORS + Socket.io). Production: your Vercel URL, no trailing slash
FRONTEND_URL=http://localhost:3000

# ── Database (MongoDB Atlas) ─────────────────────────────
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/bangalore-bachelor?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# ── AI Copilot (Google Gemini, free tier from aistudio.google.com) ──
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Minimum similarity (0 to 1) to treat a listing as a match
AI_MIN_CONFIDENCE=0.57

# ── Image uploads (Cloudinary) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Payments (Razorpay, use test keys in development) ────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Email (optional, skipped when EMAIL_USER is empty) ───
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password

# ── SMS (optional, skipped when Twilio keys are missing) ─
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number