# frontend/.env.example
# Copy to frontend/.env.local and adjust. Never put secrets here:
# REACT_APP_* values are bundled into the browser build and are public.

# Backend origin (no trailing slash, no /api suffix)
# Local:      http://localhost:5000
# Production: https://your-backend.onrender.com
REACT_APP_API_ORIGIN=http://localhost:5000